Options -Indexes

RewriteEngine On

# Nunca exponer código fuente, configuración ni documentación interna.
RewriteRule ^(?:controllers|models|config|docs|helpers)(?:/|$) - [F,L,NC]
RewriteRule ^views/.+\.php$ - [F,L,NC]

# Enviar las rutas que no son archivos físicos al front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
# Bloquear archivos ocultos (.vscode, .htaccess)
RewriteRule (^|/)\.(?!well-known) - [F]